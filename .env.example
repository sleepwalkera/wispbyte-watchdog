# Cloudflare API 令牌（必须）
# 在 https://dash.cloudflare.com/profile/api-tokens 创建，需要 Workers KV 编辑权限
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# KV 命名空间 ID（运行 `wrangler kv:namespace create MONITOR_KV` 后获取）
KV_NAMESPACE_ID=your_kv_namespace_id_here

# 监控的 Wispbyte 服务器 ID（URL 中的 8 位 ID）
SERVER_ID=your_server_id_here

# 已部署的 Worker URL（用于 make check）
WORKER_URL=https://wispbyte-watchdog.your-subdomain.workers.dev

# Discord Webhook（可选，掉线时通知）
# NOTIFY_WEBHOOK=https://discord.com/api/webhooks/...
